# 复制为 .env 后按需修改；docker compose 会自动读取同目录 .env

# 登录令牌签名密钥（生产必改）
API_TOKEN_SECRET=weshop-dev-secret

# 初始管理员账号（仅在 admins 表为空时创建，生产必改并尽快登录后修改）
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin123

# 微信小程序登录凭证（不配置则登录走 Mock 模式）
WX_APPID=
WX_SECRET=

# 信任的反向代理层数（默认 1 层；API 直连且不经过代理时设为 0）
API_TRUST_PROXY=1

# 待支付订单超时关闭（默认 900 秒）与扫描周期（默认 30 秒）
API_ORDER_TIMEOUT_SECONDS=900
API_ORDER_SWEEP_INTERVAL_SECONDS=30

# API 日志轮转（默认单个文件 5MB，含当前文件共保留 5 个）
API_LOG_MAX_BYTES=5242880
API_LOG_MAX_FILES=5

# 宿主机端口映射
WEB_PORT=8080
KTOR_PORT=8081

# Web 请求与开发代理（VITE_ 变量会进入客户端构建，不要存放密钥）
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:7101
